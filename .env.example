# Required API Keys
BIVER_API_KEY=your_biver_api_key_here
REPLIZ_ACCESS_KEY=your_repliz_access_key_here
REPLIZ_SECRET_KEY=your_repliz_secret_key_here

# Optional: Biver API Configuration
BIVER_BASE_URL=https://api.biver.id
BIVER_TIMEOUT_MS=30000

# Optional: Repliz API Configuration
REPLIZ_BASE_URL=https://api.repliz.com
REPLIZ_TIMEOUT_MS=30000

# Optional: LLM Configuration
LLM_MODEL=
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.3

# Optional: Webhook Server
WEBHOOK_PORT=3000

# Optional: Cron Scheduler
CRON_SCHEDULE=

# Optional: Logging
LOG_LEVEL=info
AUDIT_LOG_PATH=./logs/audit.jsonl

# Optional: Business Profile Storage
BUSINESS_PROFILE_PATH=./data/profiles
